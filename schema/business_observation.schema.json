{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stephanus-supandi/bloon_econonic_observatory/blob/master/schema/business_observation.schema.json",
  "title": "BLOON Economic Observatory Business Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "source_repository", "source_file", "source_record_id", "name_raw", "category_raw", "verification_status"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "source_repository": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "source_blob_sha": {"type": ["string", "null"]},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_row_number": {"type": ["integer", "null"], "minimum": 1},
    "name_raw": {"type": "string"},
    "category_raw": {"type": "string"},
    "category_code": {"type": ["string", "null"]},
    "brand_raw": {"type": ["string", "null"]},
    "business_model": {"enum": ["independent", "chain", "franchise", "cooperative", "public", "unknown"]},
    "location_raw": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "observation_date": {"type": ["string", "null"], "format": "date"},
    "operational_status": {"enum": ["open_observed", "closed_observed", "reported_closed", "unknown", "not_checked"]},
    "verification_status": {"enum": ["observed", "partially_verified", "verified", "unresolved", "not_checked"]},
    "evidence_type": {"type": ["string", "null"]},
    "evidence_reference": {"type": ["string", "null"], "format": "uri"},
    "duplicate_status": {"enum": ["unique", "possible_duplicate", "confirmed_duplicate", "unresolved"]},
    "notes": {"type": ["string", "null"]}
  }
}